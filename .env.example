# ==============================================================================
# College Lost & Found Portal - Environment Configuration
# ==============================================================================

# Supabase Project URL (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon / Public Key (from your Supabase Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mock Mode Toggle:
# Set to 'true' to use the in-memory mock backend with simulated latency.
# Set to 'false' (or omit when valid Supabase credentials are provided) to connect to Supabase.
VITE_USE_MOCK=true
